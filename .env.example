# Storage
STORAGE_PROVIDER=minio
STORAGE_DEFAULT_BUCKET=tower-tl
STORAGE_PRESIGN_TTL_MINUTES=60
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9001
STORAGE_ACCESS_KEY=admin
STORAGE_SECRET_KEY=password123
STORAGE_REGION=eu-central-1

# YOLO
YOLO_MODEL_PATH=yolov8x.pt

# Post-processing
CONF_THRESHOLD=0.35
PER_CLASS_THRESHOLDS_JSON={}
MIN_BOX_AREA=400

# ROI
ENABLE_ROI=false
ROI_CONFIG_PATH=roi_config.json

# Image quality
BLUR_THRESHOLD=50.0
BRIGHTNESS_LOW=30
BRIGHTNESS_HIGH=240
SKIP_BAD_QUALITY=false

# Postgres
POSTGRES_DSN=postgresql://sitepulse:sitepulse@localhost:5432/sitepulse

# Dropbox sync
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_TOKEN=

# Scheduler / analysis
ANALYSIS_CRON=0 0 2 * * *
MIN_DETECTIONS_ACTIVE_HOUR=3

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# CORS
CORS_ORIGINS=http://localhost:3000

# Image download safety
MAX_IMAGE_BYTES=52428800
