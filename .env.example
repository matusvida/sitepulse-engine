# ── MinIO / S3 ──────────────────────────────────────────
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9001
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password123
MINIO_BUCKET_DEFAULT=tower-tl
STORAGE_PRESIGN_TTL_MINUTES=60

# ── YOLO ────────────────────────────────────────────────
# Path or name of the Ultralytics model weights.
# "yolov8m.pt" is auto-downloaded on first run.
YOLO_MODEL_PATH=yolov8x.pt

# ── Post-processing ────────────────────────────────────
CONF_THRESHOLD=0.35
# JSON map of class_name→threshold, e.g. {"person":0.30,"truck":0.40}
PER_CLASS_THRESHOLDS_JSON={}
MIN_BOX_AREA=400

# ── ROI (optional) ─────────────────────────────────────
ENABLE_ROI=false
ROI_CONFIG_PATH=roi_config.json

# ── Image quality ──────────────────────────────────────
BLUR_THRESHOLD=50.0
BRIGHTNESS_LOW=30
BRIGHTNESS_HIGH=240
SKIP_BAD_QUALITY=false

# ── Postgres (optional) ───────────────────────────────
ENABLE_DB=false
POSTGRES_DSN=postgresql://sitepulse:sitepulse@localhost:5432/sitepulse

# ── Dropbox sync ─────────────────────────────────────
# Preferred: refresh token flow (never expires, SDK auto-refreshes).
# Get app_key and app_secret from https://www.dropbox.com/developers/apps
# Then run: python -m app.scripts.dropbox_auth to obtain a refresh token.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
# Fallback: short-lived access token (~4 hours, for quick testing only)
DROPBOX_TOKEN=
# How often to poll Dropbox for new images (minutes)
SYNC_SCHEDULE_MINUTES=60

# ── Worker ─────────────────────────────────────────────
WORKER_POLL_INTERVAL=5

# ── Scheduler / Analysis ─────────────────────────────
# Cron expression for the nightly analysis job (default: 2 AM UTC)
ANALYSIS_CRON=0 0 2 * * *
# Min detections in an hour to count that hour as "active"
MIN_DETECTIONS_ACTIVE_HOUR=3

# ── OpenAI (for AI reports + plan tracking) ──────────
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Model to use (default: gpt-4o)
OPENAI_MODEL=gpt-4.1

# ── CORS ──────────────────────────────────────────────
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# ── Image download safety ─────────────────────────────
MAX_IMAGE_BYTES=52428800
